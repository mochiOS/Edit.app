{
  "format": 1,
  "steps": [
    "$(MOCHIOS_CARGO) --manifest-path $(PROJECT)/Cargo.toml --bin edit",
    "python3 $(ROOT)/tools/devkit/build-support/package-app.py --source $(PROJECT) --binary $(RUST_TARGET_DIR)/x86_64-unknown-mochios/release/edit --mpack $(MPACK)"
  ],
  "package": {
    "name": "app-edit",
    "version": "0.1.0",
    "target": "x86_64-mochios",
    "abi": "mochios-1"
  },
  "artifact": "out/mdp/app-edit.tar.mdp",
  "exports": [
    {
      "source": "out/mdp/application/application.mpkg",
      "area": "applications",
      "destination": "edit.mpkg"
    }
  ],
  "metadata": {
    "application": {
      "source": "edit",
      "mpkg": "edit.mpkg"
    }
  }
}
